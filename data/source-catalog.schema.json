{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.expenseintel.com/data/source-catalog.schema.json",
  "title": "ExpenseIntel Source Catalog",
  "type": "object",
  "required": ["schema", "version", "reviewed_at", "sources"],
  "properties": {
    "schema": {"const": "expenseintel.source-catalog.v1"},
    "version": {"type": "integer", "minimum": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "disclaimer": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "authority", "name", "url", "domains", "role", "cadence", "integration"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "authority": {"type": "string", "minLength": 2},
          "name": {"type": "string", "minLength": 2},
          "url": {"type": "string", "pattern": "^https://"},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "role": {"enum": ["reference", "integrated", "candidate"]},
          "cadence": {"type": "string"},
          "integration": {"type": "string"}
        }
      }
    }
  }
}
